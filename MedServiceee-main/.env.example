# Frontend (Public deployment & Custom Domain configuration)
NEXT_PUBLIC_APP_URL=https://medservice.kz
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_2GIS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional Backend proxy target for same-origin rewrites
INTERNAL_API_URL=http://127.0.0.1:8000

# Backend
DATABASE_URL=sqlite:///./medservice.db
SECRET_KEY=replace-with-a-long-random-secret
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=
GEMINI_API_KEY=
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://medservice.kz,https://www.medservice.kz,https://*.vercel.app
ENABLE_EXTERNAL_AI_FALLBACK=false
ENVIRONMENT=development
